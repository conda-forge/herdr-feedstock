diff --git a/vendor/libghostty-vt/src/build/GhosttyLibVt.zig b/vendor/libghostty-vt/src/build/GhosttyLibVt.zig
--- a/vendor/libghostty-vt/src/build/GhosttyLibVt.zig
+++ b/vendor/libghostty-vt/src/build/GhosttyLibVt.zig
@@ -267,6 +267,56 @@
             // The Zig standard library uses NT and kernel32 symbols.
             lib.root_module.linkSystemLibrary("ntdll", .{});
             lib.root_module.linkSystemLibrary("kernel32", .{});
+        }
+
+        // On Windows with MSVC, building a DLL requires the full CRT library
+        // chain. linkLibC() provides msvcrt.lib, but that references symbols
+        // in vcruntime.lib and ucrt.lib. Zig's library search paths include
+        // the MSVC lib dir and the Windows SDK 'um' dir, but not the SDK
+        // 'ucrt' dir where ucrt.lib lives. This mirrors the fix that already
+        // exists in GhosttyLib.zig for the libghostty DLL.
+        if (kind == .shared and target.result.abi == .msvc) {
+            // For dynamic linking, we prefer dynamic linking and to search
+            // by mode first.
+            const dynamic_link_opts: std.Build.Module.LinkSystemLibraryOptions = .{
+                .preferred_link_mode = .dynamic,
+                .search_strategy = .mode_first,
+            };
+
+            // The CRT initialization code in msvcrt.lib calls
+            // __vcrt_initialize and __acrt_initialize, which are in the
+            // static CRT libraries.
+            lib.root_module.linkSystemLibrary("libvcruntime", dynamic_link_opts);
+
+            // ucrt.lib is in the Windows SDK 'ucrt' dir. Detect the SDK
+            // installation and add the UCRT library path.
+            const arch = target.result.cpu.arch;
+            const sdk = std.zig.WindowsSdk.find(
+                b.allocator,
+                b.graph.io,
+                arch,
+                &b.graph.environ_map,
+            ) catch null;
+            if (sdk) |s| {
+                if (s.windows10sdk) |w10| {
+                    const arch_str: []const u8 = switch (arch) {
+                        .x86_64 => "x64",
+                        .x86 => "x86",
+                        .aarch64 => "arm64",
+                        else => "x64",
+                    };
+                    const ucrt_lib_path = std.fmt.allocPrint(
+                        b.allocator,
+                        "{s}\\Lib\\{s}\\ucrt\\{s}",
+                        .{ w10.path, w10.version, arch_str },
+                    ) catch null;
+
+                    if (ucrt_lib_path) |path| {
+                        lib.root_module.addLibraryPath(.{ .cwd_relative = path });
+                    }
+                }
+            }
+            lib.root_module.linkSystemLibrary("libucrt", dynamic_link_opts);
         }
     }
 
